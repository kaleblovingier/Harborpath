{
  "name": "harborpath-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Privacy-first finder for addiction treatment, harm reduction tools, and related health services, built on official SAMHSA, HRSA, and Census data.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node -e \"import('node:fs').then(fs => fs.existsSync('scripts/build-check.mjs') && import('./scripts/build-check.mjs').then(m => m.runBuildCheck().then(r => !r.ok && process.exit(1))))\"",
    "lint": "node scripts/build-check.mjs --lint",
    "test": "node --test",
    "data:build": "node scripts/build-data.mjs"
  }
}
